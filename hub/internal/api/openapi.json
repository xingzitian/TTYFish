          },
          "429": {
            "description": "来源 IP 每分钟预算用尽；Retry-After: 60",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "fingerprint",
            "in": "path",
            "required": true,
            "description": "完整 SHA256: 指纹，作为一个路径段进行 URL 编码",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "玩家会话令牌"
      },
      "gatewayAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "TTYFISH_GATEWAY_TOKEN 服务端凭证，不能用玩家令牌替代"
      }
    },
    "schemas": {
      "Account": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "username",
          "display_name",
          "created_at"
        ]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "access_token": {
            "type": "string",
            "description": "仅返回一次的随机会话令牌；服务端仅保存哈希"
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expires_in": {
            "type": "integer",
            "enum": [
              86400
            ]
          },
          "account": {
            "$ref": "#/components/schemas/Account"
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "account"
        ]
      },
      "Key": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fingerprint": {
            "type": "string"
          },
          "public_key": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "fingerprint",
          "public_key",
          "created_at"
        ]
      },
      "Registration": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,19}$",
            "example": "alice"
          },
          "password": {
            "type": "string",
            "description": "可选；非空时必须为 10–72 个 UTF-8 字节"
          },
          "public_key": {
            "type": "string",
            "description": "可选，单个 OpenSSH 公钥；密码和公钥至少提供一项"
          }
        },
        "required": [
          "username"
        ]
      },
      "PasswordLogin": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "SSHLogin": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string"
          },
          "public_key": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "public_key"
        ]
      },
      "Password": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "password": {
            "type": "string",
            "description": "10–72 个 UTF-8 字节，不允许全空白"
          }
        },
        "required": [
          "password"
        ]
      },
      "PublicKey": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "public_key": {
            "type": "string",
            "description": "一把 OpenSSH 公钥，不允许证书、authorized_keys 选项或多把公钥"
          }
        },
        "required": [
          "public_key"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_request",
                  "invalid_credentials",
                  "account_conflict",
                  "not_found",
                  "last_credential",
                  "origin_denied",
                  "method_not_allowed",
                  "request_too_large",
                  "unsupported_media_type",
                  "rate_limited",
                  "internal_error",
                  "gateway_disabled",
                  "gateway_unauthorized"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
